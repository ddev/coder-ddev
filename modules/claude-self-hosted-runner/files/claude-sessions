#!/usr/bin/env bash
# List the runner's live sessions: id, checkout, branch, and commits on no remote
# branch, so a person can find a session's work without asking it.
set -u
pgrep -af -- '--sdk-url' | while read -r _ cmd; do
  id=$(grep -o 'sessions/cse_[A-Za-z0-9]*' <<<"$cmd" | head -1 | cut -d/ -f2)
  for dir in $(grep -o -- '--add-dir [^ ]*' <<<"$cmd" | cut -d' ' -f2 | grep -v '/_sessions/'); do
    git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || continue
    branch=$(git -C "$dir" branch --show-current)
    ahead=$(git -C "$dir" rev-list --count HEAD --not --remotes)
    printf '%s  %s  %s  unpushed: %s\n' "$id" "$dir" "$branch" "$ahead"
  done
done | sort -u
