#!/usr/bin/env bash
# PreToolUse hook for Bash: refuse commands that print a credential.
#
# A session once wrote a commit message inside bash -c "...", quoting
# `coder external-auth access-token github` in backticks. The shell ran it and
# put the owner's GitHub token into a pushed commit. Nothing a session does
# needs these commands' output in its context; tools that need a token (such
# as gh-read) fetch it themselves, outside the Bash tool's command string.
set -uo pipefail

cmd="$(jq -r '.tool_input.command // empty' 2>/dev/null)"
[ -n "$cmd" ] || exit 0

pattern='external-auth[[:space:]]+access-token|gh[[:space:]]+auth[[:space:]]+token|git[[:space:]]+credential[[:space:]]+fill'
if printf '%s' "$cmd" | grep -qE "$pattern"; then
  cat >&2 <<'EOF'
Blocked: this command would print a credential (a GitHub or Coder token) into the session, where it can end up in a commit, a PR or a log. Don't run it, and don't quote it in backticks or $() inside a double-quoted string, which runs it. To read GitHub outside the session's repositories, use gh-read; it fetches the token itself. To put text that mentions such a command into a commit or PR, write the text to a file and pass it with git commit -F or --body-file.
EOF
  exit 2
fi
exit 0
