#!/usr/bin/env bash
# Keep Claude Code self-hosted runner number $1 running; it exits on its own
# when --release-idle-session-min leaves it with no sessions.
# --use-anthropic-git-proxy requires --capacity 1, so concurrent sessions come
# from several runners, each with its own clones and its own global git config.
set -u
n="$1"
base="${base_dir}/runner-$n"
mkdir -p "$base"
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
export GIT_CONFIG_GLOBAL="$base/.gitconfig"
# The workspace SSH agent relay (shared/ssh-agent-setup.sh): the user's
# forwarded agent when one is connected, otherwise the Coder workspace key.
# Without it, sessions can't push to an SSH remote such as a fork.
export SSH_AUTH_SOCK="$HOME/.ssh-agent-relay/agent.sock"
# The runner keeps its checkouts between sessions. Its post-session hook cleans
# them (claude-runner-sweep), and so does this loop before every start, for a
# runner that was killed before its hook ran, as when the workspace stops.
hooks="$HOME/.claude-runner/hooks/runner-$n"
mkdir -p "$hooks"
printf '#!/usr/bin/env bash\nexec "$HOME/.local/bin/claude-runner-sweep" %q\n' "$base" >"$hooks/post-session"
chmod +x "$hooks/post-session"
while true; do
  "$HOME/.local/bin/claude-runner-sweep" "$base"
  started=$(date +%s)
  /home/linuxbrew/.linuxbrew/bin/claude self-hosted-runner \
    --environment-secret-file "${secret_file}" \
    --base-dir "$base" \
    --hooks-dir "$hooks" \
    --post-session-hook-timeout-sec 120 \
    --capacity 1 \
    --client-label "$CODER_WORKSPACE_NAME-$n" \
    --use-anthropic-git-proxy \
    --release-idle-session-min 30 \
    --kill-session-after-min 480 \
    --health-port 0 \
    --log-file "/tmp/claude-runner-$n.log"
  rc=$?
  # A runner that fails at once (a revoked secret, no network) would otherwise retry every 5s.
  delay=5
  [ $(( $(date +%s) - started )) -lt 60 ] && delay=60
  echo "$(date): runner $n exited ($rc); restarting in $${delay}s"
  sleep "$delay"
done
