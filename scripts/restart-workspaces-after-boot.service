[Unit]
Description=Restart running Coder workspaces after a host reboot
After=network-online.target docker.service coder.service
Wants=network-online.target

[Service]
Type=oneshot
User=rfay
EnvironmentFile=/etc/workspace-lifecycle-cleanup.env
ExecStart=/usr/local/bin/restart-workspaces-after-boot --force

[Install]
WantedBy=multi-user.target
