#!/usr/bin/env bash
#ddev-silent-no-warn

## Description: Install Coder post-start hook into this DDEV project
## Usage: coder-setup
## Example: "ddev coder-setup"

set -euo pipefail

if [ ! -f ".ddev/config.yaml" ]; then
  echo "Error: no .ddev/config.yaml found. Run 'ddev config' first."
  exit 1
fi

# Write config.coder.yaml alongside config.yaml
if [ -z "${VSCODE_PROXY_URI:-}" ]; then
  echo "Warning: VSCODE_PROXY_URI not set — web container will not have it available"
fi

_WORKSPACE="${CODER_WORKSPACE_NAME:-}"
_OWNER="${CODER_WORKSPACE_OWNER_NAME:-}"
_AGENT="${CODER_WORKSPACE_AGENT_NAME:-${CODER_AGENT_NAME:-main}}"
_DOMAIN=""
if [ -n "${VSCODE_PROXY_URI:-}" ]; then
  _DOMAIN=$(echo "$VSCODE_PROXY_URI" | sed -E 's|https?://[^.]+\.(.+?)(/.*)?$|\1|')
elif [ -n "${CODER_AGENT_URL:-}" ]; then
  _DOMAIN=$(echo "$CODER_AGENT_URL" | sed -E 's|https?://(.+?)(/.*)?$|\1|')
fi
_SLUG=""
if [ -n "${DDEV_SITENAME:-}" ]; then
  _SLUG=$(echo "$DDEV_SITENAME" | tr '[:upper:]' '[:lower:]' | tr '._' '--' | tr -s '-')
fi

# external_url_template/external_urls make 'ddev start', 'ddev describe',
# 'ddev list' and 'ddev launch' show Coder URLs instead of *.ddev.site. Any router
# port is reachable at Coder's port-forwarding URL, which coder-routes routes with
# PathPrefix. Router ports 8080/8025/8143 are shared by every project in the
# workspace, so they use the per-project coder_app slugs the templates define
# (and coder-routes routes by Host) instead. DDEV versions without these keys ignore them.
_EXTERNAL_URLS=""
if [ -n "$_WORKSPACE" ] && [ -n "$_OWNER" ] && [ -n "$_DOMAIN" ] && [ -n "$_SLUG" ]; then
  _SUFFIX="--${_WORKSPACE}--${_OWNER}.${_DOMAIN}"
  _EXTERNAL_URLS="external_url_template: \"https://{{port}}--${_AGENT}${_SUFFIX}\"
external_urls:
  \"8080\": \"https://${_SLUG}${_SUFFIX}\"
  \"8025\": \"https://mailpit-${_SLUG}${_SUFFIX}\"
  \"8143\": \"https://xhgui-${_SLUG}${_SUFFIX}\""
fi

cat > .ddev/config.coder.yaml << EOF
#ddev-silent-no-warn
# Coder-specific DDEV hooks (auto-generated by ddev coder-setup, do not edit)
#
# Coder environment variables injected into the DDEV web container so that
# tools running inside it (e.g. Vite/Astro dev servers) can construct correct
# URLs and detect the Coder environment:
#   CODER                      - set to "true"; use to detect a Coder workspace
#   CODER_AGENT_URL            - Coder server base URL (e.g. ${CODER_AGENT_URL:-https://coder.example.com/})
#   CODER_WORKSPACE_AGENT_NAME - agent name used in Coder subdomain URLs (e.g. ${CODER_WORKSPACE_AGENT_NAME:-main})
#   CODER_WORKSPACE_NAME       - workspace name; used in subdomain URL construction (e.g. ${CODER_WORKSPACE_NAME:-myproject})
#   CODER_WORKSPACE_OWNER_NAME - workspace owner; used in subdomain URL construction (e.g. ${CODER_WORKSPACE_OWNER_NAME:-username})
#   VSCODE_PROXY_URI           - proxy URL template for port forwarding
#                                (e.g. ${VSCODE_PROXY_URI:-https://{{port}}--agent--workspace--owner.domain})
#                                used to derive the allowed host domain for dev servers
web_environment:
  - CODER=${CODER:-}
  - CODER_AGENT_URL=${CODER_AGENT_URL:-}
  - CODER_WORKSPACE_AGENT_NAME=${CODER_WORKSPACE_AGENT_NAME:-}
  - CODER_WORKSPACE_NAME=${CODER_WORKSPACE_NAME:-}
  - CODER_WORKSPACE_OWNER_NAME=${CODER_WORKSPACE_OWNER_NAME:-}
  - VSCODE_PROXY_URI=${VSCODE_PROXY_URI:-}
${_EXTERNAL_URLS}
hooks:
  post-start:
    - exec-host: ddev coder-routes
  post-stop:
    - exec-host: rm -f $HOME/.ddev/traefik/custom-global-config/coder-routes-\${DDEV_SITENAME}.yaml
EOF
echo "✓ Wrote .ddev/config.coder.yaml"

# DDEV versions that understand external_urls show the Coder URLs above
# themselves, so the docker-compose.coder-describe.yaml fallback is removed there.
#
# Older DDEV ignores external_urls, so for those write
# docker-compose.coder-describe.yaml with x-ddev.describe-url-port for the primary
# web service and Mailpit, so 'ddev describe' shows a working Coder URL before the
# first start. coder-routes rewrites it on every post-start with an entry per
# service it routes. DDEV reads describe-url-port from the compose config built at
# the last start, so a newly discovered service shows up one restart later. It
# cannot fix web_extra_exposed_ports rows, which DDEV builds without consulting it.
if ddev describe -j 2>/dev/null | jq -e '.raw.primary_external_url // empty' >/dev/null 2>&1; then
  rm -f .ddev/docker-compose.coder-describe.yaml
elif [ -n "$_EXTERNAL_URLS" ]; then
  cat > .ddev/docker-compose.coder-describe.yaml << EOF
#ddev-silent-no-warn
# Auto-generated by ddev coder-setup — do not edit.
# Superseded by coder-routes after the first 'ddev start'.
services:
  web:
    x-ddev:
      describe-url-port: |
        https://${_SLUG}${_SUFFIX}
        Mailpit: https://mailpit-${_SLUG}${_SUFFIX}
      describe-info: "Use: ddev launch"
EOF
  echo "✓ Wrote .ddev/docker-compose.coder-describe.yaml"
fi

# Gitignore it so it doesn't end up in the project repo
mkdir -p ~/.config/git
if ! grep -qF ".ddev/config.coder.yaml" ~/.config/git/ignore 2>/dev/null; then
  echo ".ddev/config.coder.yaml" >> ~/.config/git/ignore
  echo "✓ Added .ddev/config.coder.yaml to ~/.config/git/ignore"
fi
if ! grep -qF ".ddev/docker-compose.coder-describe.yaml" ~/.config/git/ignore 2>/dev/null; then
  echo ".ddev/docker-compose.coder-describe.yaml" >> ~/.config/git/ignore
  echo "✓ Added .ddev/docker-compose.coder-describe.yaml to ~/.config/git/ignore"
fi

# Warn if this project's name isn't in the registered project list.
if [ -n "${CODER_PROJECT_NAMES:-}" ] && [ -n "${DDEV_SITENAME:-}" ]; then
  IFS=',' read -ra _registered <<< "$CODER_PROJECT_NAMES"
  _found=false
  for _name in "${_registered[@]}"; do
    if [ "$(echo "$_name" | tr -d ' ')" = "$DDEV_SITENAME" ]; then
      _found=true
      break
    fi
  done
  if [ "$_found" = "false" ]; then
    echo ""
    echo "⚠️  WARNING: DDEV project name '$DDEV_SITENAME' is not in the registered project list: $CODER_PROJECT_NAMES"
    echo "   Routing will not work until this project name is added."
    echo "   Edit the workspace and update the 'DDEV project names' parameter to include '$DDEV_SITENAME',"
    echo "   then restart the workspace to create the matching app button."
  fi
fi

echo ""
echo "Coder routing hook installed. Run 'ddev start' to activate routing."
echo "The hook runs automatically after every 'ddev start'."
